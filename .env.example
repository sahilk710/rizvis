# ============================================================
# J.A.R.V.I.S. — Environment Variables
# Copy this file to .env and fill in your API keys
# ============================================================

# LiveKit Cloud (get from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project-xxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API key (get from https://aistudio.google.com/projects)
GOOGLE_API_KEY=your-google-api-key

# OpenAI API key — used for TTS (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx

# Deepgram API key — used for STT (get from https://console.deepgram.com)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Optional: Groq API key (only if switching LLM_PROVIDER to "groq")
GROQ_API_KEY=

# Optional: Server config
SERVER_NAME=J.A.R.V.I.S.
DEBUG=false
